><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="DDL Oracle tự commit → không rollback theo transaction.&lt;br&gt;Xoá file code object: allow_drop=false → fail, cần migration DROP." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="520" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3. Drift &amp; DB sync" id="p1792458907261396051"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Drift check &amp; DB sync (DB → Git, kiểu &quot;sync fork&quot;)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="40" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Kích hoạt&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;ovc sync --env &amp;lt;env&amp;gt;&lt;br&gt;hoặc drift đêm + auto_sync&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="170" height="80" as="geometry"/></mxCell><mxCell id="c3" value="Lock branch của env&lt;br&gt;đọc &lt;b&gt;last deployed SHA&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;(OVC_READER)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="250" y="90" width="170" height="80" as="geometry"/></mxCell><mxCell id="c4" value="Export DDL từ DB&lt;br&gt;chuẩn hoá giống init" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="460" y="90" width="160" height="80" as="geometry"/></mxCell><mxCell id="c5" value="Có khác&lt;br&gt;biệt?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="660" y="90" width="90" height="80" as="geometry"/></mxCell><mxCell id="c6" value="no_change" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="655" y="220" width="100" height="40" as="geometry"/></mxCell><mxCell id="c7" value="Tạo &lt;b&gt;DB-state commit&lt;/b&gt;&lt;br&gt;cha = base&lt;br&gt;&lt;font style='font-size:10px'&gt;trailer OVC-Sync: env; base&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="790" y="90" width="180" height="80" as="geometry"/></mxCell><mxCell id="c8" value="Merge 3 chiều&lt;br&gt;vào đầu branch&lt;br&gt;sạch?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1010" y="80" width="120" height="100" as="geometry"/></mxCell><mxCell id="c9" value="Push lên branch env&lt;br&gt;(service account OVC)&lt;br&gt;&lt;font style='font-size:10px'&gt;FF hoặc merge commit + trailer&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1180" y="90" width="190" height="80" as="geometry"/></mxCell><mxCell id="c10" value="Branch sync/&amp;lt;env&amp;gt;/&amp;lt;time&amp;gt;&lt;br&gt;+ MR (exit 5)&lt;br&gt;&lt;font style='font-size:10px'&gt;dev giải conflict rồi merge&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1010" y="240" width="180" height="80" as="geometry"/></mxCell><mxCell id="c11" value="Pipeline: &lt;b&gt;record-sync&lt;/b&gt;&lt;br&gt;ghi OVC_DEPLOY_LOG = SYNCED&lt;br&gt;&lt;font style='font-size:10px'&gt;không chạy DDL&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1180" y="380" width="190" height="80" as="geometry"/></mxCell><mxCell id="c12" value="MR lan thay đổi&lt;br&gt;main → release/* → develop" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1175" y="520" width="200" height="80" as="geometry"/></mxCell><mxCell id="c13" value="Bảng/index đổi?&lt;br&gt;→ nhãn &lt;b&gt;needs-migration&lt;/b&gt;&lt;br&gt;dev viết migration +&lt;br&gt;--mark-applied ở env đã sửa tay" style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="860" y="510" width="240" height="100" as="geometry"/></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="sạch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="conflict" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c9" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="sau khi&lt;br&gt;merge MR" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1100" y="420"/></Array></mxGeometry></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="&lt;b&gt;Merge 3 chiều&lt;/b&gt;&lt;br&gt;base = last deployed SHA (DB đáng lẽ phải như này)&lt;br&gt;ours = DB hiện tại (thay đổi ngoài luồng)&lt;br&gt;theirs = đầu branch (commit chưa deploy)&lt;br&gt;→ không mất commit đã merge mà chưa deploy" style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="360" height="110" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Muốn bỏ thay đổi trên DB?&lt;/b&gt;&lt;br&gt;Không sync – deploy lại từ Git để đè&lt;br&gt;(code object chạy lại CREATE OR REPLACE)" style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="360" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>