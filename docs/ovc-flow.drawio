xGeometry x="220" y="380" width="130" height="80" as="geometry"/></mxCell><mxCell id="c19" value="Chạy &lt;b&gt;migration&lt;/b&gt;&lt;br&gt;chưa có trong&lt;br&gt;OVC_MIGRATION_LOG" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="380" y="380" width="150" height="80" as="geometry"/></mxCell><mxCell id="c20" value="Chạy &lt;b&gt;code object&lt;/b&gt; theo thứ tự&lt;br&gt;&lt;font style='font-size:10px'&gt;sequence/synonym → type spec → pkg spec&lt;br&gt;→ func/proc → view → body → trigger → grants&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="560" y="380" width="260" height="80" as="geometry"/></mxCell><mxCell id="c21" value="Recompile&lt;br&gt;so invalid trước/sau" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="850" y="380" width="140" height="80" as="geometry"/></mxCell><mxCell id="c22" value="Invalid&lt;br&gt;mới?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1020" y="380" width="90" height="80" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;SUCCESS&lt;/b&gt;&lt;br&gt;ghi OVC_DEPLOY_LOG" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1150" y="380" width="150" height="80" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;FAILED&lt;/b&gt; (exit 6)&lt;br&gt;sửa → deploy tiếp&lt;br&gt;(roll-forward)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1020" y="520" width="150" height="70" as="geometry"/></mxCell><mxCell id="c25" value="merge vào develop / release/* / main" style="edgeStyle=orthogonalEdgeStyle;r