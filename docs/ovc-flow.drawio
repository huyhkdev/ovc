iteSpace=wrap;html=1;size=14;fontSize=11;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="260" y="600" width="200" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2. Luồng làm việc &amp; deploy" id="p452597057218125591"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Luồng làm việc của dev → deploy" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="700" height="40" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;ovc clone&lt;/b&gt; / &lt;b&gt;branch create&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;snapshot tar.gz + base_sha&lt;br&gt;feature/&amp;lt;user&amp;gt;/&amp;lt;tên&amp;gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="170" height="90" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Sửa file local&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;ovc status · diff · restore&lt;br&gt;ovc new migration&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="260" y="90" width="170" height="90" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;ovc pull&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;merge 3 chiều trên server&lt;br&gt;base · local · remote&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="480" y="90" width="170" height="90" as="geometry"/></mxCell><mxCell id="c5" value="Conflict?" style="rhombus;whiteSpace=wrap;html=1;fontSi